# Resend — https://resend.com/api-keys
# Without this the contact form returns 503 (the build still succeeds).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verify your own domain in Resend and use it here. The default sandbox
# sender (onboarding@resend.dev) will ONLY deliver to the address your Resend
# account is registered under — every other recipient is rejected with a 403.
CONTACT_FROM_EMAIL="Portfolio Contact <hello@yourdomain.com>"

# Where enquiries land. Until a domain is verified this MUST be the Resend
# account address, which is not necessarily the address shown on the site.
CONTACT_TO_EMAIL=anubhavmaurya8521@gmail.com

# Public site origin — powers canonical URLs, OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
